{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reed",
  "version": "0.6.0",
  "identifier": "org.estira.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Reed",
        "width": 440,
        "height": 700,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection",
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Pausas activas con estiramientos guiados",
    "longDescription": "Reed te recuerda hacer pausas y te guía con estiramientos animados, elegidos según tu espacio y lo que tienes a mano.",
    "category": "HealthcareAndFitness",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Spanish"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3RDYyODU2QTNDQUY3RTYKUldUbTk4cWpWaWpXUis2b2hORHlpL3R1enMyS0dlaUZ1OHd3OERWU3dRVmdNTndJeEx3WUk0aXoK",
      "endpoints": [
        "https://github.com/Verlezza/estira/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
