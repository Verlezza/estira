{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Estira",
  "version": "0.2.0",
  "identifier": "org.estira.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Estira",
        "width": 440,
        "height": 700,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Pausas activas con estiramientos guiados",
    "longDescription": "Estira te recuerda hacer pausas y te guía con estiramientos animados, elegidos según tu espacio y lo que tienes a mano.",
    "category": "HealthcareAndFitness",
    "copyright": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Spanish"]
      }
    }
  }
}
